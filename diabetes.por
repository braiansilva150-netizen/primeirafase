programa {
  funcao inicio() {//entendimento
   //calcular o lucro que a dona bete teve no distancia 
   // infos e variveis  
   real bruto, presentes, premiacoes, comissoes
  real lucro  
 
    //entrada de dados 
    escreva("digite o bruto")
  leia(bruto)
  escreva("digite o valor dos presentes")
leia(presentes) 
escreva("o valor das  premiacoes")
leia(premiacoes) 
escreva("o valor das comisssoes")
leia(comissoes)
    //processamento
        lucro = bruto - (presentes + premiacoes + comissoes) 





    //apresentar resultados
    escreva("O lucro total foi: ", lucro)






  }
}